{
  "name": "amrutam-telemedicine-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Enterprise-grade Telemedicine Engine for Amrutam Healthcare (Node.js, PostgreSQL 16, Redis 7)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --test dist/tests/unit/*.test.js dist/tests/integration/*.test.js",
    "test:ts": "tsx --test tests/**/*.test.ts",
    "migrate": "tsx src/database/migrate.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "telemedicine",
    "ayurveda",
    "amrutam",
    "distributed-locking",
    "postgresql",
    "redis",
    "redlock"
  ],
  "author": "Amrutam Engineering",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.8",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
